{
  "datasets": [
    {
      "name": "ds_channel",
      "displayName": "Channel marketing performance",
      "queryLines": [
        "SELECT\n",
        "  acquisition_channel,\n",
        "  customers,\n",
        "  total_orders,\n",
        "  total_revenue,\n",
        "  avg_predictive_clv,\n",
        "  total_campaign_cost,\n",
        "  cac,\n",
        "  marketing_roi,\n",
        "  ltv_to_cac_ratio,\n",
        "  impressions,\n",
        "  clicks,\n",
        "  click_through_rate\n",
        "FROM gold_channel_marketing_performance"
      ]
    },
    {
      "name": "ds_rfm",
      "displayName": "Customer RFM",
      "queryLines": [
        "SELECT\n",
        "  customer_id,\n",
        "  acquisition_channel,\n",
        "  recency_days,\n",
        "  frequency,\n",
        "  monetary,\n",
        "  r_score,\n",
        "  f_score,\n",
        "  m_score,\n",
        "  rfm_segment\n",
        "FROM gold_customer_rfm"
      ]
    },
    {
      "name": "ds_champions",
      "displayName": "Champions count",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS champions\n",
        "FROM gold_customer_rfm\n",
        "WHERE rfm_segment = 'Champions'"
      ]
    },
    {
      "name": "ds_at_risk_lost",
      "displayName": "At risk / lost count",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS at_risk_lost\n",
        "FROM gold_customer_rfm\n",
        "WHERE rfm_segment IN ('At Risk', 'Lost', 'Cannot Lose Them')"
      ]
    }
  ],
  "pages": [

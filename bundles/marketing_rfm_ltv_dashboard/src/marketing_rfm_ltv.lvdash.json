      "name": "page_channel",
      "displayName": "Channel ROI & CAC",
      "layout": [
        {
          "widget": {
            "name": "w_total_revenue",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_channel",
                  "fields": [
                    {
                      "name": "sum_total_revenue",
                      "expression": "SUM(`total_revenue`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum_total_revenue",
                  "displayName": "Total revenue",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "decimalPlaces": {
                      "type": "exact",
                      "places": 0
                    }
                  }
                }
              },
              "frame": {
                "title": "Total revenue",
                "showTitle": true
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 2,
            "height": 3
          }
